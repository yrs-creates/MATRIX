# PUX PILOT Server Environment Configuration
PORT=3001

# Leave as 127.0.0.1 for local-only access. Use 0.0.0.0 only to expose the app
# to other devices on your network.
HOST=127.0.0.1

# Optional: Add one or more free/paid API keys.
# The server will automatically use the best available provider and cascade:
# Groq -> OpenRouter -> Gemini -> Local Offline Rule Engine.
# If no keys are provided, the app will run 100% locally with built-in rule intelligence.

# 1. Groq API Key (Free tier: 30 RPM, fast inference for chat)
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# 2. OpenRouter API Key (Multi-model free & low-cost fallback)
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# 3. Google Gemini API Key (Multimodal image analysis)
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
